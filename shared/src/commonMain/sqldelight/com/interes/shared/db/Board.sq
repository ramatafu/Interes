CREATE TABLE Board (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    category TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    -- NULL = доска активна. Не NULL = "удалена" — на самом деле лежит в
    -- Корзине (см. TrashScreen.kt), ждёт восстановления или окончательного
    -- удаления. Все обычные запросы (список досок, поиск и т.д.) её не
    -- видят — фильтруются по deletedAt IS NULL ниже.
    deletedAt INTEGER
);

selectAllBoards:
SELECT * FROM Board WHERE deletedAt IS NULL ORDER BY createdAt DESC;

selectBoardById:
SELECT * FROM Board WHERE id = ?;

selectBoardsByCategory:
SELECT * FROM Board WHERE category = ? AND deletedAt IS NULL ORDER BY createdAt DESC;

selectTrashedBoards:
SELECT * FROM Board WHERE deletedAt IS NOT NULL ORDER BY deletedAt DESC;

insertBoard:
INSERT INTO Board (title, category, createdAt) VALUES (?, ?, ?);

-- Настоящее удаление строки — теперь используется только из Корзины
-- ("Удалить навсегда", см. BoardRepository.permanentlyDeleteBoard). Обычное
-- удаление из списка досок — softDeleteBoard ниже.
deleteBoard:
DELETE FROM Board WHERE id = ?;

softDeleteBoard:
UPDATE Board SET deletedAt = ? WHERE id = ?;

restoreBoard:
UPDATE Board SET deletedAt = NULL WHERE id = ?;

updateBoardTitle:
UPDATE Board SET title = ? WHERE id = ?;

-- Для карточек в списке досок: название/категория + пути к первым ТРЁМ
-- по порядку фото доски (для коллажа "1+2" в BoardsListScreen.kt), плюс
-- общее количество фото в доске.
--
-- ВАЖНО: именно LEFT JOIN, а не скалярный подзапрос в SELECT-списке.
-- Первая версия этого запроса брала thumbnailPath2/thumbnailPath3 через
-- "(SELECT filePath ... LIMIT 1 OFFSET N)" — SQLDelight в таком случае
-- определяет nullable/non-null ПО ИСХОДНОЙ КОЛОНКЕ В СХЕМЕ (Photo.filePath
-- у нас NOT NULL), а не по тому, что подзапрос может вернуть 0 строк.
-- Итог — сгенерированный код читал колонку как non-null String с "!!"
-- внутри, и на доске с 1-2 фото падал NullPointerException на подзапросах
-- для несуществующего 2-го/3-го фото. LEFT JOIN SQLDelight обрабатывает
-- отдельно: правая сторона join'а ВСЕГДА nullable независимо от схемы —
-- поэтому thumbnailPath/2/3 корректно генерируются как String?.
--
-- orderIndex внутри доски уникален (BoardRepository.addPhotoToBoard всегда
-- берёт max(orderIndex)+1), поэтому join по конкретному orderIndex не
-- размножает строки доски.
selectBoardsWithThumbnail:
SELECT Board.id, Board.title, Board.category, Board.createdAt,
    P1.filePath AS thumbnailPath,
    P2.filePath AS thumbnailPath2,
    P3.filePath AS thumbnailPath3,
    (SELECT COUNT(*) FROM Photo pc WHERE pc.boardId = Board.id) AS photoCount
FROM Board
LEFT JOIN Photo P1 ON P1.boardId = Board.id
    AND P1.orderIndex = (SELECT p.orderIndex FROM Photo p WHERE p.boardId = Board.id ORDER BY p.orderIndex ASC LIMIT 1 OFFSET 0)
LEFT JOIN Photo P2 ON P2.boardId = Board.id
    AND P2.orderIndex = (SELECT p.orderIndex FROM Photo p WHERE p.boardId = Board.id ORDER BY p.orderIndex ASC LIMIT 1 OFFSET 1)
LEFT JOIN Photo P3 ON P3.boardId = Board.id
    AND P3.orderIndex = (SELECT p.orderIndex FROM Photo p WHERE p.boardId = Board.id ORDER BY p.orderIndex ASC LIMIT 1 OFFSET 2)
WHERE Board.deletedAt IS NULL
ORDER BY Board.createdAt DESC;

lastInsertRowId:
SELECT last_insert_rowid();